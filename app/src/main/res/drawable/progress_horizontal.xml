<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="6dp" />
            <solid android:color="@color/timeline_track" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="6dp" />
                <gradient
                    android:startColor="@color/accent_pastel_purple"
                    android:endColor="@color/accent_pastel_orange"
                    android:angle="0" />
            </shape>
        </clip>
    </item>
</layer-list>